# ── Database ──────────────────────────────────────────────
# Create the database first (pgAdmin, or: createdb -U postgres zanvar_exam)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/zanvar_exam?schema=public"

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origin(s) of the web app, comma separated (dev: Vite on 5173; prod: your HTTPS URL)
CLIENT_ORIGIN=http://localhost:5173
# Used in email links
APP_URL=http://localhost:5173
# Production: serve the built React app from this server (single origin)
SERVE_CLIENT=false
# Set true when running behind IIS / nginx / a load balancer
TRUST_PROXY=false

# ── Security ──────────────────────────────────────────────
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_HOURS=12
# true in production (requires HTTPS)
COOKIE_SECURE=false

# ── File storage (resumes, verification photos, evidence) ─
STORAGE_DIR=./storage

# ── Email (leave SMTP_HOST empty in development: emails print to the console) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zanvar Group Talent Portal <no-reply@zanvargroup.com>"

# ── Google sign-in (Firebase Authentication) ── optional ──
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
# These values are public identifiers, not secrets. Leave empty to hide "Continue with Google".
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Let existing HR / Super Admin accounts also sign in with Google (only when the Google email matches)
GOOGLE_STAFF_SIGNIN=true
